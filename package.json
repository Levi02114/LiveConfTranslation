{
  "name": "live-conf-translation",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false server.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "NODE_ENV=production tsx server.ts",
    "electron": "npm run build && electron . --no-sandbox",
    "prepare:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "dist:win": "npm run build && npm run prepare:cloudflared && electron-builder --win nsis portable --x64",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "description": "로컬 네트워크용 실시간 세션 번역 릴레이",
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "io.github.nemit.live-conf-translation",
    "productName": "Live Conference Translation",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "!.next/cache/**/*",
      "dist/server.cjs",
      "electron/**/*",
      "!electron/*.test.cjs",
      "public/**/*",
      "next.config.mjs",
      "postcss.config.mjs",
      "package.json",
      "!data/**/*",
      "!.env*",
      "!.tmp/**/*"
    ],
    "extraResources": [
      {
        "from": ".tmp/cloudflared-windows-amd64.exe",
        "to": "cloudflared.exe"
      },
      {
        "from": ".tmp/cloudflared-LICENSE",
        "to": "cloudflared-LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
