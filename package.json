{
  "name": "live-conf-translation",
  "version": "0.9.29",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false server.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "NODE_ENV=production tsx server.ts",
    "electron": "npm run build && electron . --no-sandbox",
    "prepare:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "dist:win": "npm run build && npm run prepare:cloudflared && electron-builder --win nsis portable --x64",
    "lint": "eslint && oxlint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prepare-vad.mjs",
    "dist:mac": "npm run build && npm run prepare:cloudflared -- --mac && electron-builder --mac dir --arm64 --x64 && node scripts/zip-mac.mjs"
  },
  "dependencies": {
    "@fontsource/unifont": "^5.3.0",
    "@google-cloud/speech": "^7.5.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@zoom/appssdk": "0.16.41",
    "fasttext.wasm": "^1.0.1",
    "next": "16.4.6",
    "pdfkit": "^0.20.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "electron": "43.8.12",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "oxlint": "1.79.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "description": "로컬 네트워크용 실시간 세션 번역 릴레이",
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "io.github.levi02114.live-conf-translation",
    "productName": "Live Conference Translation",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "!.next/cache/**/*",
      "!.next/dev/**/*",
      "dist/server.cjs",
      "electron/**/*",
      "!electron/*.test.cjs",
      "public/**/*",
      "next.config.mjs",
      "postcss.config.mjs",
      "package.json",
      "!node_modules/@next/swc-linux-*/**/*",
      "!node_modules/@img/sharp-linux*/**/*",
      "!node_modules/@img/sharp-libvips-linux*/**/*",
      "!data/**/*",
      "!.env*",
      "!.tmp/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": ".tmp/cloudflared-windows-amd64.exe",
          "to": "cloudflared.exe"
        },
        {
          "from": ".tmp/cloudflared-LICENSE",
          "to": "cloudflared-LICENSE.txt"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "세션 음성을 실시간 전사하려면 마이크가 필요합니다. / Microphone access is used for live session transcription.",
        "NSAudioCaptureUsageDescription": "컴퓨터 소리(Zoom 등)를 전사하려면 시스템 오디오 녹음 권한이 필요합니다. / System audio access is used to transcribe computer sound such as Zoom."
      },
      "extraResources": [
        {
          "from": ".tmp/cloudflared-darwin-${arch}",
          "to": "cloudflared"
        },
        {
          "from": ".tmp/cloudflared-LICENSE",
          "to": "cloudflared-LICENSE.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "ko_KR",
        "vi_VN",
        "th_TH"
      ],
      "include": "electron/installer.nsh"
    }
  },
  "overrides": {
    "google-gax": {
      "rimraf": "6.1.4"
    }
  }
}
