# ─────────────────────────────────────────────────────────────
# 실시간 회의 번역 릴레이 — 환경변수
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#   cp .env.example .env.local
# .env.local 은 git 에 올라가지 않는다.
# ─────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────

# 관리자 로그인 비밀번호. 회의 개설과 로그 조회에 필요하다.
ADMIN_PASSWORD=

# 관리자 세션 쿠키 서명 키. 아무 긴 무작위 문자열이면 된다.
# 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 이 값을 바꾸면 로그인된 세션이 모두 끊긴다.
SESSION_SECRET=

# ── 번역 엔진 ────────────────────────────────────────────────

# 회의를 새로 만들 때 기본으로 선택되는 엔진: google | deepl | openai
TRANSLATION_ENGINE=google

# Google Cloud Translation API v2 키.
# 대상 4개 언어(한국어·베트남어·태국어·싱할라어)를 모두 지원한다.
# 발급: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=

# DeepL API 키.
#
# ⚠️ DeepL 은 싱할라어(si)를 지원하지 않는다.
#    엔진을 deepl 로 두어도 싱할라어 방향은 자동으로 Google 번역으로 넘어간다.
#    따라서 싱할라어를 쓰는 회의라면 GOOGLE_TRANSLATE_API_KEY 도 반드시 필요하다.
#
# 무료 플랜 키는 :fx 로 끝나며 엔드포인트가 자동으로 api-free.deepl.com 으로 잡힌다.
DEEPL_API_KEY=

# DeepL 엔드포인트를 직접 지정할 때만 쓴다. 보통 비워 둔다.
# DEEPL_API_URL=

# OpenAI (LLM 번역) 키.
#
# 기계 번역과 달리 직전 발언을 문맥으로 함께 넘겨, 대명사와 용어를 회의 흐름에
# 맞춰 준다. 대신 지연과 비용이 더 크다. 4개 언어를 모두 지원한다.
OPENAI_API_KEY=

# 번역에 쓸 모델. 자막은 지연이 중요해 작은 모델이 기본이다.
# 실제 계정에서 쓸 수 있는 모델인지 한 번 확인할 것.
# OPENAI_TRANSLATION_MODEL=gpt-5.4-mini

# OpenAI 호환 게이트웨이를 쓸 때만 지정한다.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 선택 ─────────────────────────────────────────────────────

# SQLite 파일 경로. 기본값은 data/meetings.db
# DATABASE_PATH=data/meetings.db

# 관리자 세션 유효 기간(초). 기본 43200 = 12시간
# SESSION_TTL_SECONDS=43200
