# ─────────────────────────────────────────────────────────────
# 실시간 세션 번역 릴레이 — 환경변수
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#   cp .env.example .env.local
# .env.local 은 git 에 올라가지 않는다.
# ─────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────

# 관리자 로그인 비밀번호. 세션 개설과 로그 조회에 필요하다.
ADMIN_PASSWORD=

# 관리자 세션 쿠키 서명 키. 아무 긴 무작위 문자열이면 된다.
# 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 이 값을 바꾸면 로그인된 세션이 모두 끊긴다.
SESSION_SECRET=

# ── 번역 엔진 ────────────────────────────────────────────────
#
# API 키는 관리자 화면(/admin)의 "API 키 등록" 버튼으로도 넣을 수 있다.
# 그렇게 넣은 키는 암호화되어 DB 에 저장되고 **여기 값보다 우선한다.**
# 아래 변수는 처음 배포할 때의 기본값 역할이다.
#
# ⚠️ DB 암호화 키는 SESSION_SECRET 에서 파생된다. SESSION_SECRET 을 바꾸면
#    화면에서 등록해 둔 API 키를 읽을 수 없게 되어 다시 등록해야 한다.

# 세션을 새로 만들 때 기본으로 선택되는 엔진: google | deepl | openai
TRANSLATION_ENGINE=google

# Google Cloud Translation API v2 키.
#
# 관리자 화면에서 추가할 수 있는 언어 카탈로그는 Google 지원 목록을 기준으로 한다.
# 발급: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=

# DeepL API 키.
#
# 지원 언어는 실행 중 DeepL /v2/languages API에서 자동으로 확인한다.
#    해당 언어가 필요하면 세션 생성 시 별도의 폴백 엔진을 선택한다.
#
# 무료 플랜 키는 :fx 로 끝나며 엔드포인트가 자동으로 api-free.deepl.com 으로 잡힌다.
DEEPL_API_KEY=

# DeepL 엔드포인트를 직접 지정할 때만 쓴다. 보통 비워 둔다.
# DEEPL_API_URL=

# OpenAI (LLM 번역) 키.
#
# 기계 번역과 달리 직전 발언을 문맥으로 함께 넘겨, 대명사와 용어를 세션 흐름에
# 맞춰 준다. 대신 지연과 비용이 더 크다. 언어 제한은 두지 않는다.
OPENAI_API_KEY=

# 번역에 쓸 모델의 **기본값**. 자막은 지연이 중요해 작은 모델이 기본이다.
#
# 관리자 화면에서 엔진을 OpenAI 로 고르면 모델 드롭다운이 나오고, 거기서 정한 값이
# `engine_settings` 테이블에 저장되어 **이 변수보다 우선한다**(전역 설정 1개).
# 목록은 DB 캐시를 먼저 보여 주고, 관리 화면 진입 때 계정의 /models 로 갱신한다.
# OPENAI_TRANSLATION_MODEL=gpt-5.4-mini

# OpenAI 호환 게이트웨이를 쓸 때만 지정한다.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 선택 ─────────────────────────────────────────────────────

# SQLite 파일 경로. 기본값은 data/meetings.db
# DATABASE_PATH=data/meetings.db

# 관리자 세션 유효 기간(초). 기본 43200 = 12시간
# SESSION_TTL_SECONDS=43200
