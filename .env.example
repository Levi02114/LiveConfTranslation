# ─────────────────────────────────────────────────────────────
# 실시간 세션 번역 릴레이 — 환경변수
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#   cp .env.example .env.local
# .env.local 은 git 에 올라가지 않는다.
# ─────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────

# 관리자 로그인 비밀번호. 세션 개설과 로그 조회에 필요하다.
ADMIN_PASSWORD=

# 관리자 세션 쿠키 서명 키. 아무 긴 무작위 문자열이면 된다.
# 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 이 값을 바꾸면 로그인된 세션이 모두 끊긴다.
SESSION_SECRET=

# 번역 API 키는 환경변수로 받지 않는다.
# 서버를 실행한 뒤 관리자 화면(/admin)의 "API 키 등록"에서 설정한다.
# OpenAI 번역 모델은 gpt-5.6-luna로 고정되어 별도 설정이 없다.
# 키는 SESSION_SECRET 으로 암호화되어 SQLite에 저장되므로, SESSION_SECRET 을 바꾸면
# 기존 키를 복호화할 수 없다. 바꾼 뒤에는 관리자 화면에서 키를 다시 등록해야 한다.

# ── 선택 ─────────────────────────────────────────────────────

# SQLite 파일 경로. 기본값은 data/meetings.db
# DATABASE_PATH=data/meetings.db

# 관리자 세션 유효 기간(초). 기본 43200 = 12시간
# SESSION_TTL_SECONDS=43200

# 소스 실행의 공개 origin. 실제 HTTPS 주소를 쉼표로 구분한다.
# LAN/loopback은 자동 허용된다. Quick Tunnel 주소가 바뀌면 갱신한다.
# ALLOWED_ORIGINS=https://translation.example.org

# Electron 없는 서버에서도 앱 설정의 공유 주소/Telegram을 사용할 수 있다.
# 서버가 직접 Quick/고정 Tunnel을 시작하려면 cloudflared를 PATH에 설치하거나 경로 지정.
# 고정 도메인은 앱 설정에서 등록하며 cloudflared 2025.4.0 이상 필요. 토큰은 여기에 쓰지 않는다.
# CLOUDFLARED_PATH=/usr/local/bin/cloudflared
# systemd/별도 프로세스로 이미 관리하는 터널이 있다면 공개 주소를 지정한다.
# 해당 터널을 새로 만들거나 종료하지 않고 공유 주소로 사용한다.
# SERVER_PUBLIC_ORIGIN=https://your-tunnel.trycloudflare.com

# 서버에 직접 연결하는 신뢰 프록시의 IP만 지정한다. 독립 서버는 로컬 tunnel용 loopback을 신뢰한다.
# 로컬 cloudflared 사용 시 실제 연결 IP에 맞춰 설정한다.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# 소스 실행에서 직접 설치한 로컬 AI를 연결할 때만 설정한다.
# Windows 설치형은 아래 값을 desktop-settings.json에서 자동으로 구성한다.
# LOCAL_LLAMA_SERVER_PATH=C:\path\to\llama-server.exe
# LOCAL_TRANSLATION_MODEL_PATH=C:\path\to\translategemma-4b-it.Q4_K_M.gguf
# LOCAL_WHISPER_SERVER_PATH=C:\path\to\whisper-server.exe
# LOCAL_TRANSCRIPTION_MODEL_PATH=C:\path\to\ggml-small.bin
# LOCAL_AI_USE_GPU=1

# ── 고급: 호환 API 서버를 직접 운영할 때만 ────────────────

# DeepL 호환 엔드포인트. 보통은 지정하지 않는다.
# DEEPL_API_URL=https://api.deepl.com

# OpenAI 호환 게이트웨이. 보통은 지정하지 않는다.
# OPENAI_BASE_URL=https://api.openai.com/v1
